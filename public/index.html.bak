<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
<title>CLANXU — OFFICIAL CODM CLAN</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header>
  <img src="logo.png" alt="XU CLAN" class="clan-logo">
  <div class="brand">CLAN<span>XU</span></div>
  <div class="tag">XTREME UNIT · <b>ONE NAME. ONE FORCE.</b></div>
  <div class="threat-quote">
    ⚔ "WE DON'T PLAY TO WIN.<br>WE PLAY TO MAKE YOU <span>REMEMBER US.</span>" ⚔
  </div>
  <button id="logoutBtn" onclick="logout()">LOGOUT</button>
</header>

<div class="tabs">
  <div class="tab active" onclick="switchTab('chat',event)">◆ CHAT</div>
  <div class="tab" onclick="switchTab('ranking',event)" id="tabRanking">◈ RANKING</div>
  <div class="tab" onclick="switchTab('profile',event)">▸ PROFILE</div>
  <div class="tab" onclick="switchTab('tryout',event)" id="tabTryout">⚔ TRYOUT</div>
  <div class="tab" onclick="switchTab('invite',event)" id="tabInvite">🔗 INVITE</div>
  <div class="tab" onclick="switchTab('mailbox',event)" id="tabMailbox" style="display:none">📬 MAIL</div>
  <div class="tab" onclick="switchTab('admin',event)" id="tabAdmin" style="display:none">★ ADMIN</div>
</div>

<div id="content-chat" class="content active">
  <div id="announcement"></div>
  <div id="chat"></div>
  <div class="controls">
    <input type="text" id="msgInput" placeholder="MESSAGE...">
    <button onclick="sendMsg()">SEND</button>
    <button class="record-btn" id="recBtn">●</button>
  </div>
</div>

<div id="content-ranking" class="content">
  <div class="hero">
    <div class="hero-logo">CLANXU</div>
    <div class="hero-sub">— <b>TOP WARRIORS</b> —</div>
  </div>
  <div class="card">
    <h3>CLAN LEADERBOARD</h3>
    <p style="color:var(--dim);font-size:11px;margin-bottom:12px;font-family:'JetBrains Mono'">// tap any warrior to view intel</p>
    <div id="leaderboard"></div>
  </div>
</div>

<div id="content-profile" class="content">
  <div class="card">
    <h3>MY PROFILE</h3>
    <div style="text-align:center;margin-bottom:18px">
      <img id="myAvatar" class="avatar" src="https://via.placeholder.com/90/0d0d14/ff1e2d?text=CX" alt="">
      <p id="myIGN" style="color:#fff;font-weight:700;font-size:20px;font-family:'Orbitron';margin-top:10px;letter-spacing:2px"></p>
      <span id="myBadge" class="badge-role"></span>
      <p id="myRank" style="color:var(--gold);font-size:13px;margin-top:8px;font-family:'Orbitron';letter-spacing:2px"></p>
    </div>
    <label>CODM UID</label>
    <input type="text" id="pUid" placeholder="123456789">
    <label>RANK</label>
    <select id="pRank">
      <option>Rookie</option><option>Veteran</option><option>Elite</option>
      <option>Pro</option><option>Master</option><option>Grandmaster</option>
      <option>Legendary</option><option>ClanXU Elite</option>
    </select>
    <label>HUD CODE</label>
    <input type="text" id="pHud" placeholder="HUD layout code">
    <label>SENSITIVITY CODE</label>
    <input type="text" id="pSensi" placeholder="Sensi code">
    <label>UPLOAD PROFILE PICTURE (from phone)</label>
<input type="file" id="pFile" accept="image/*" style="padding:8px;background:var(--bg2);border:1px solid var(--line);color:#fff;border-radius:2px;width:100%;font-size:12px">
<label>UPLOAD COLLECTION SCREENSHOT (from phone)</label>
<input type="file" id="cFile" accept="image/*" style="padding:8px;background:var(--bg2);border:1px solid var(--line);color:#fff;border-radius:2px;width:100%;font-size:12px">
<label>OR PASTE IMGUR LINK</label>
<input type="text" id="pShot" placeholder="https://i.imgur.com/...">

<div id="content-tryout" class="content">
  <div class="hero">
    <div class="hero-logo">TRYOUT</div>
    <div class="hero-sub">— <b>JOIN THE ELITE</b> —</div>
  </div>
  <div class="card">
    <h3>TRYOUT APPLICATION</h3>
    <label>IGN</label>
    <input type="text" id="tUser" placeholder="Your IGN">
    <label>CODM UID</label>
    <input type="text" id="tUid" placeholder="123456789">
    <label>RANK</label>
    <select id="tRank">
      <option>Rookie</option><option>Veteran</option><option>Elite</option>
      <option>Pro</option><option>Master</option><option>Grandmaster</option>
      <option>Legendary</option><option>ClanXU Elite</option>
    </select>
    <label>ROLE / PLACEMENT</label>
    <select id="tRole">
      <option>Sniper</option><option>Rusher</option><option>IGL</option>
      <option>Support</option><option>Anchor</option><option>Roamer</option>
      <option>Flex</option><option>LMG</option>
    </select>
    <label>HUD CODE</label>
    <input type="text" id="tHud" placeholder="HUD code">
    <label>SENSITIVITY CODE</label>
    <input type="text" id="tSensi" placeholder="Sensi code">
    <label>REASON</label>
    <textarea id="tMsg" rows="3" placeholder="Bakit gusto mong sumali sa ClanXU?"></textarea>
    <button class="btn-gold" style="width:100%;margin-top:16px" onclick="submitTryout()">📩 SUBMIT TRYOUT</button>
  </div>
</div>

<div id="content-invite" class="content">
  <div class="card">
    <h3>INVITE FRIENDS</h3>
    <p style="color:var(--dim);font-size:13px;margin-bottom:12px">I-share ang link para makapag-register sila sa clan.</p>
    <div class="invite-box">
      <p style="color:var(--green);font-family:'Orbitron';font-size:10px;letter-spacing:2px;margin-bottom:4px">YOUR INVITE LINK</p>
      <div class="invite-link" id="inviteLink">loading...</div>
      <button class="btn-green" style="width:100%;margin-top:12px" onclick="copyInvite()">📋 COPY LINK</button>
    </div>
  </div>
</div>

<div id="content-mailbox" class="content">
  <div class="card">
    <h3>MAILBOX</h3>
    <p style="color:var(--dim);font-size:11px;font-family:'JetBrains Mono';margin-bottom:12px">// admin-only view</p>
    <h4>▎ JOIN REQUESTS (<span id="jCount">0</span>)</h4>
    <div id="mailJoinList"><p class="empty">no requests</p></div>
    <h4>▎ ADMIN REQUESTS (<span id="aCount">0</span>)</h4>
    <div id="mailAdminList"><p class="empty">no requests</p></div>
    <h4>▎ TRYOUTS (<span id="tCount">0</span>)</h4>
    <div id="mailTryoutList"><p class="empty">no tryouts</p></div>
  </div>
</div>

<div id="content-admin" class="content">
  <div class="card">
    <h3>COMMAND CENTER</h3>
    <label>ANNOUNCEMENT</label>
    <input type="text" id="annInput" placeholder="Broadcast message...">
    <button class="btn-gold" style="width:100%;margin-top:10px" onclick="postAnnounce()">📢 BROADCAST</button>
    <h4>▎ ROSTER MANAGEMENT</h4>
    <div id="memberList"></div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const socket = io();
let isAdmin = false;
let myName = 'Guest';
let myRole = 'Member';
let mediaRec, chunks = [];
window.currentUsers = [];

const savedKey = localStorage.getItem('clanx_key');
const savedName = localStorage.getItem('clanx_name');
const savedAdmin = localStorage.getItem('clanx_admin') === 'true';
const savedRole = localStorage.getItem('clanx_role') || 'Member';

function logout(){if(confirm('Logout ka ba?')){localStorage.clear();location.reload();}}

const urlParams = new URLSearchParams(window.location.search);
const inviteFrom = urlParams.get('invite');

if (savedKey && savedName) {
  myName = savedName;
  myRole = savedRole;
  socket.emit('check-key', savedKey);
  socket.on('key-result', ok => {
    if (!ok) { localStorage.clear(); location.reload(); return; }
    if (savedAdmin) socket.emit('admin-login', { password: 'CLANXU2026', username: savedName });
    else socket.emit('request-join', { username: savedName, uid: localStorage.getItem('clanx_uid')||'N/A', rank: localStorage.getItem('clanx_rank')||'Rookie', screenshot: '', type: savedRole === 'Tryouter' ? 'tryouter' : 'member' });
  });
} else {
  const key = prompt('[ClanXU] Enter Clan Key:');
  if (!key) { location.reload(); }
  socket.emit('check-key', key);
  socket.on('key-result', ok => {
    if (!ok) { alert('INVALID CLAN KEY'); location.reload(); return; }
    const roleChoice = prompt('PUMILI NG ROLE:\n\n[1] ADMIN\n[2] MEMBER (full access)\n[3] TRYOUTER (limited)', '2');
    if (roleChoice === '1') {
      const pwd = prompt('Admin Password:');
      const name = prompt('Your IGN:');
      myName = name || 'Admin'; myRole = 'Admin';
      localStorage.setItem('clanx_key', key);
      localStorage.setItem('clanx_name', myName);
      localStorage.setItem('clanx_admin', 'true');
      localStorage.setItem('clanx_role', 'Admin');
      socket.emit('admin-login', { password: pwd, username: myName });
    } else if (roleChoice === '3') {
      const name = prompt('Your IGN (Tryouter):');
      if (!name) { location.reload(); return; }
      myName = name; myRole = 'Tryouter';
      localStorage.setItem('clanx_key', key);
      localStorage.setItem('clanx_name', myName);
      localStorage.setItem('clanx_admin', 'false');
      localStorage.setItem('clanx_role', 'Tryouter');
      socket.emit('request-join', { username: myName, uid: 'N/A', rank: 'Rookie', screenshot: '', type: 'tryouter' });
    } else {
      const name = prompt('Your IGN (Member):');
      if (!name) { location.reload(); return; }
      myName = name; myRole = 'Member';
      localStorage.setItem('clanx_key', key);
      localStorage.setItem('clanx_name', myName);
      localStorage.setItem('clanx_admin', 'false');
      localStorage.setItem('clanx_role', 'Member');
      socket.emit('request-join', { username: myName, uid: 'N/A', rank: 'Rookie', screenshot: '', type: 'member', invitedBy: inviteFrom });
    }
  });
}

socket.on('role-result', (data) => {
  myRole = data.role;
  localStorage.setItem('clanx_role', data.role);
  applyRoleUI();
  if (data.user) fillProfileFields(data.user);
});

socket.on('admin-approved', () => {
  isAdmin = true; myRole = 'Admin';
  localStorage.setItem('clanx_role', 'Admin');
  document.body.classList.add('admin-on');
  applyRoleUI();
  socket.emit('get-mailbox');
});

function applyRoleUI() {
  const tr = document.getElementById('tabRanking');
  const ti = document.getElementById('tabInvite');
  const tm = document.getElementById('tabMailbox');
  const ta = document.getElementById('tabAdmin');
  if (myRole === 'Tryouter') {
    if (tr) tr.style.display = 'none';
    if (ti) ti.style.display = 'none';
    if (tm) tm.style.display = 'none';
    if (ta) ta.style.display = 'none';
  } else if (myRole === 'Admin') {
    if (tr) tr.style.display = 'block';
    if (ti) ti.style.display = 'block';
    if (tm) tm.style.display = 'block';
    if (ta) ta.style.display = 'block';
  } else {
    if (tr) tr.style.display = 'block';
    if (ti) ti.style.display = 'block';
    if (tm) tm.style.display = 'none';
    if (ta) ta.style.display = 'none';
  }
  const b = document.getElementById('myBadge');
  if (b) { b.textContent = myRole; b.className = 'badge-role role-' + myRole; }
}

socket.on('admin-login-fail', m => { alert(m); location.reload(); });
socket.on('wait-admin-approval', () => alert('Wait for admin approval...'));
socket.on('admin-denied', () => { alert('Denied.'); location.reload(); });
socket.on('wait-approval', () => alert('Wait for admin approval...'));
socket.on('denied', () => { alert('Denied.'); location.reload(); });
socket.on('role-promoted', (u) => { if (u === myName) { myRole = 'Member'; applyRoleUI(); alert('PROMOTED TO MEMBER'); } });
socket.on('user-renamed', ({oldName, newName}) => {
  if (oldName === myName) { myName = newName; localStorage.setItem('clanx_name', newName); }
});
socket.on('user-kicked', (u) => { if (u === myName) { alert('KICKED.'); localStorage.clear(); location.reload(); } });
socket.on('new-user-request', () => { if (isAdmin) socket.emit('get-mailbox'); });
socket.on('new-admin-request', () => { if (isAdmin) socket.emit('get-mailbox'); });

let sendingMsg = false;
function sendMsg() {
  if (sendingMsg) return;
  const input = document.getElementById('msgInput');
  const v = input.value.trim();
  if (!v) return;
  sendingMsg = true;
  input.value = '';
  const msgId = myName + '|' + Date.now() + '|' + Math.random().toString(36).substr(2, 6);
  socket.emit('chat-message', { user: myName, text: v, msgId: msgId });
  setTimeout(() => { sendingMsg = false; }, 1200);
}
socket.on('chat-message', m => addMsg(m));
socket.on('message-deleted', id => { const e = document.getElementById('m-'+id); if(e) e.remove(); });

function addMsg(m){
  const c = document.getElementById('chat');
  const d = document.createElement('div');
  d.className='msg'; d.id='m-'+m.id;
  const content = m.type==='voice' ? '<audio controls src="'+m.text+'"></audio>' : escapeHtml(m.text);
  d.innerHTML='<div><strong>'+escapeHtml(m.user)+'</strong> '+content+'<br><small style="color:var(--dim);font-family:JetBrains Mono;font-size:10px">'+m.time+'</small></div><button class="del-btn" onclick="delMsg(\''+m.id+'\')">✕</button>';
  c.appendChild(d); c.scrollTop=c.scrollHeight;
}
function delMsg(id){socket.emit('delete-message',id);}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

document.getElementById('msgInput').addEventListener('keypress', (e) => {
  if (e.key === 'Enter') {
    e.preventDefault();
    sendMsg();
  }
});

const recBtn = document.getElementById('recBtn');
recBtn.onmousedown = recBtn.ontouchstart = startRec;
recBtn.onmouseup = recBtn.ontouchend = stopRec;
async function startRec(e){
  e.preventDefault();
  try{
    const stream = await navigator.mediaDevices.getUserMedia({audio:true});
    mediaRec = new MediaRecorder(stream); chunks=[];
    mediaRec.ondataavailable = ev=>chunks.push(ev.data);
    mediaRec.onstop = ()=>{
      const blob = new Blob(chunks,{type:'audio/webm'});
      const r = new FileReader();
      r.onloadend = ()=>socket.emit('chat-message',{user:myName,text:r.result,type:'voice'});
      r.readAsDataURL(blob);
      stream.getTracks().forEach(t=>t.stop());
    };
    mediaRec.start(); recBtn.classList.add('recording');
  }catch(err){alert('Mic denied.');}
}
function stopRec(){if(mediaRec&&mediaRec.state!=='inactive'){mediaRec.stop();recBtn.classList.remove('recording');}}

socket.on('announcement', a=>{
  const el = document.getElementById('announcement');
  el.style.display='block'; el.textContent=a.text;
});
function postAnnounce(){
  const v = document.getElementById('annInput').value.trim();
  if(v){socket.emit('announce',v); document.getElementById('annInput').value='';}
}

function saveProfile(){
  socket.emit('save-profile',{
    username: myName,
    uid: document.getElementById('pUid').value,
    rank: document.getElementById('pRank').value,
    hudcode: document.getElementById('pHud').value,
    sensicode: document.getElementById('pSensi').value,
    screenshot: document.getElementById('pShot').value
  });
}
socket.on('profile-saved', ()=>alert('PROFILE SAVED'));

function fillProfileFields(u) {
  if (!u) return;
  document.getElementById('myIGN').textContent = myName;
  document.getElementById('pUid').value = u.uid || '';
  document.getElementById('pRank').value = u.rank || 'Rookie';
  document.getElementById('pHud').value = u.hudcode || '';
  document.getElementById('pSensi').value = u.sensicode || '';
  document.getElementById('pShot').value = u.screenshot || '';
  const b = document.getElementById('myBadge');
  b.textContent = myRole; b.className = 'badge-role role-' + myRole;
}

socket.on('users-update', users=>{
  window.currentUsers = users;
  const order = ['ClanXU Elite','Legendary','Grandmaster','Master','Pro','Elite','Veteran','Rookie'];
  const sorted = [...users].sort((a,b)=>order.indexOf(a.rank)-order.indexOf(b.rank));
  const lb = document.getElementById('leaderboard');
  if(sorted.length===0){lb.innerHTML='<p class="empty">// no warriors yet</p>';}
  else {
    lb.innerHTML = sorted.map((u,i)=>{
      const cls = (u.rank||'Rookie').replace(/\s+/g,'');
      const roleCls = 'role-' + (u.role || 'Member');
      return '<div class="lb-row" onclick="showMemberInfo(\''+escapeHtml(u.username)+'\')">'+
        '<span><span class="lb-rank">#'+String(i+1).padStart(2,'0')+'</span><span class="lb-name">'+escapeHtml(u.username)+'</span><span class="role-tag '+roleCls+'">'+(u.role||'Member')+'</span></span>'+
        '<span class="tier '+cls+'">'+u.rank+'</span></div>';
    }).join('');
  }
  const me = users.find(u=>u.username===myName);
  if(me) fillProfileFields(me);

  const ml = document.getElementById('memberList');
  if (ml && isAdmin) {
    ml.innerHTML = users.map(u => {
      const roleCls = 'role-' + (u.role || 'Member');
      return '<div style="background:var(--bg2);padding:12px;border-radius:2px;margin-bottom:6px;border-left:2px solid var(--red)">'+
        '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:8px">'+
          '<span><strong style="font-family:Orbitron;font-size:12px;color:#fff">'+escapeHtml(u.username)+'</strong><span class="role-tag '+roleCls+'">'+(u.role||'Member')+'</span></span>'+
        '</div>'+
        '<div style="display:flex;gap:5px;flex-wrap:wrap">'+
          '<button onclick="renameUser(\''+escapeHtml(u.username)+'\')" class="btn-cyan" style="padding:5px 10px;font-size:9px">✏ RENAME</button>' +
          (u.role === 'Tryouter' ? '<button onclick="promoteUser(\''+escapeHtml(u.username)+'\')" class="btn-green" style="padding:5px 10px;font-size:9px">⬆ PROMOTE</button>' : '') +
          '<button onclick="kickUser(\''+escapeHtml(u.username)+'\')" style="padding:5px 10px;font-size:9px">✕ KICK</button>'+
        '</div></div>';
    }).join('');
  }
});

function renameUser(oldName) {
  const newName = prompt('Rename ' + oldName + ' to:', oldName);
  if (newName && newName !== oldName) socket.emit('rename-user', { oldName, newName });
}
function promoteUser(username) {
  if (confirm('Promote ' + username + ' to MEMBER?')) socket.emit('promote-tryouter', username);
}
function kickUser(username) {
  if (confirm('KICK ' + username + '?')) socket.emit('kick-user', username);
}

function showMemberInfo(username){
  const u = window.currentUsers.find(x=>x.username===username);
  if(!u) return;
  const old = document.getElementById('memberModal'); if(old) old.remove();
  const modal = document.createElement('div');
  modal.id='memberModal';
  modal.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,0.92);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick=e=>{if(e.target===modal) modal.remove();};
  const roleCls = 'role-' + (u.role || 'Member');
  modal.innerHTML='<div style="background:var(--card);border:2px solid var(--red);border-radius:3px;padding:22px;max-width:420px;width:100%;max-height:85vh;overflow-y:auto;position:relative">'+
    '<div style="position:absolute;top:0;left:0;width:40px;height:3px;background:var(--red)"></div>'+
    '<div style="position:absolute;top:0;left:0;width:3px;height:40px;background:var(--red)"></div>'+
    '<div style="text-align:center;margin-bottom:18px">'+
      '<h2 style="color:#fff;font-family:Orbitron;font-weight:900;font-size:22px;letter-spacing:3px;margin:0">'+escapeHtml(u.username)+'</h2>'+
      '<span class="role-tag '+roleCls+'" style="margin-top:10px">'+(u.role||'Member')+'</span>'+
      '<p style="color:var(--gold);font-family:Orbitron;font-size:12px;letter-spacing:2px;margin-top:10px">'+u.rank+'</p>'+
    '</div>'+
    '<div style="background:var(--bg2);border-radius:2px;padding:12px;margin-bottom:8px;border-left:2px solid var(--red)"><p style="color:var(--dim);font-family:Orbitron;font-size:9px;letter-spacing:2px">UID</p><p style="color:#fff;font-size:15px;font-weight:700;margin-top:4px">'+escapeHtml(u.uid||'N/A')+'</p></div>'+
    '<div style="background:var(--bg2);border-radius:2px;padding:12px;margin-bottom:8px;border-left:2px solid var(--gold)"><p style="color:var(--dim);font-family:Orbitron;font-size:9px;letter-spacing:2px">HUD CODE</p><p style="color:#fff;font-size:13px;word-break:break-all;margin-top:4px">'+escapeHtml(u.hudcode||'N/A')+'</p></div>'+
    '<div style="background:var(--bg2);border-radius:2px;padding:12px;margin-bottom:8px;border-left:2px solid var(--cyan)"><p style="color:var(--dim);font-family:Orbitron;font-size:9px;letter-spacing:2px">SENSI CODE</p><p style="color:#fff;font-size:13px;word-break:break-all;margin-top:4px">'+escapeHtml(u.sensicode||'N/A')+'</p></div>'+
    '<div style="background:var(--bg2);border-radius:2px;padding:12px;margin-bottom:12px;border-left:2px solid var(--line)"><p style="color:var(--dim);font-family:Orbitron;font-size:9px;letter-spacing:2px;margin-bottom:8px">SCREENSHOT</p>'+(u.screenshot?'<img src="'+u.screenshot+'" style="width:100%;border-radius:2px;border:2px solid var(--red)">':'<p style="color:var(--dim);font-size:12px">No screenshot.</p>')+'</div>'+
    '<button onclick="document.getElementById(\'memberModal\').remove()" style="width:100%;margin-top:6px">CLOSE</button></div>';
  document.body.appendChild(modal);
}

function submitTryout(){
  socket.emit('submit-tryout',{
    username: document.getElementById('tUser').value,
    uid: document.getElementById('tUid').value,
    rank: document.getElementById('tRank').value,
    role: document.getElementById('tRole').value,
    hudcode: document.getElementById('tHud').value,
    sensicode: document.getElementById('tSensi').value,
    message: document.getElementById('tMsg').value
  });
}
socket.on('tryout-submitted', ()=>alert('TRYOUT SUBMITTED'));

socket.on('mailbox-data', d=>{if(isAdmin) renderMailbox(d);});
socket.on('mailbox-refresh', d=>{if(isAdmin) renderMailbox(d);});

function renderMailbox(data){
  if(!data) return;
  document.getElementById('jCount').textContent = data.joins.length;
  document.getElementById('aCount').textContent = data.admins.length;
  document.getElementById('tCount').textContent = data.tryouts.length;

  const j = document.getElementById('mailJoinList');
  j.innerHTML = data.joins.length===0 ? '<p class="empty">// none</p>' :
    data.joins.map(r=>{
      const cls = (r.rank||'Rookie').replace(/\s+/g,'');
      const typeLabel = r.type === 'tryouter' ? '<span class="role-tag role-Tryouter">TRYOUTER</span>' : '<span class="role-tag role-Member">MEMBER</span>';
      return '<div class="mbox"><div style="display:flex;justify-content:space-between;align-items:center"><strong>'+escapeHtml(r.username)+'</strong>'+typeLabel+'</div>'+
      '<p style="color:var(--dim);font-size:12px;margin:6px 0">UID: '+(r.uid||'N/A')+' · <span class="tier '+cls+'">'+(r.rank||'Rookie')+'</span></p>'+
      (r.hudcode?'<p style="color:var(--dim);font-size:11px">HUD: '+escapeHtml(r.hudcode)+'</p>':'')+
      (r.sensicode?'<p style="color:var(--dim);font-size:11px">Sensi: '+escapeHtml(r.sensicode)+'</p>':'')+
      (r.invitedBy?'<p style="color:var(--dim);font-size:11px">Invited by: '+escapeHtml(r.invitedBy)+'</p>':'')+
      '<div style="margin-top:8px"><button class="btn-green" onclick="socket.emit(\'approve-user\',\''+r.id+'\')" style="padding:6px 12px;font-size:9px">✅ ACCEPT</button> <button onclick="socket.emit(\'deny-user\',\''+r.id+'\')" style="padding:6px 12px;font-size:9px;background:#333">❌ DENY</button></div></div>';
    }).join('');

  const a = document.getElementById('mailAdminList');
  a.innerHTML = data.admins.length===0 ? '<p class="empty">// none</p>' :
    data.admins.map(r=>'<div class="mbox"><strong>'+r.username+'</strong><div style="margin-top:8px"><button class="btn-green" onclick="socket.emit(\'approve-admin\',\''+r.id+'\')" style="padding:6px 12px;font-size:9px">✅ ACCEPT</button> <button onclick="socket.emit(\'deny-admin\',\''+r.id+'\')" style="padding:6px 12px;font-size:9px;background:#333">❌ DENY</button></div></div>').join('');

  const t = document.getElementById('mailTryoutList');
  t.innerHTML = data.tryouts.length===0 ? '<p class="empty">// none</p>' :
    data.tryouts.map(r=>{
      const cls = (r.rank||'Rookie').replace(/\s+/g,'');
      return '<div class="mbox"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><strong>'+escapeHtml(r.username)+'</strong><span class="tier '+cls+'">'+(r.rank||'Rookie')+'</span></div>'+
        '<p style="color:var(--dim);font-size:12px;margin:4px 0">UID: '+(r.uid||'N/A')+'</p>'+
        '<p style="color:var(--dim);font-size:12px;margin:4px 0">Role: <strong style="color:var(--cyan)">'+(r.role||'N/A')+'</strong></p>'+
        (r.hudcode?'<p style="color:var(--dim);font-size:12px">HUD: '+escapeHtml(r.hudcode)+'</p>':'')+
        (r.sensicode?'<p style="color:var(--dim);font-size:12px">Sensi: '+escapeHtml(r.sensicode)+'</p>':'')+
        '<p style="color:var(--txt);font-size:12px;margin:6px 0">'+(r.message||'')+'</p>'+
        '<div style="margin-top:8px"><button class="btn-green" onclick="socket.emit(\'approve-tryout\','+r.id+')" style="padding:6px 12px;font-size:9px">✅ ACCEPT</button> <button onclick="socket.emit(\'deny-tryout\','+r.id+')" style="padding:6px 12px;font-size:9px;background:#333">❌ DENY</button></div></div>';
    }).join('');
}

function generateInviteLink() {
  const baseUrl = window.location.origin + window.location.pathname;
  const link = baseUrl + '?invite=' + encodeURIComponent(myName);
  const el = document.getElementById('inviteLink');
  if (el) el.textContent = link;
}
function copyInvite() {
  const link = document.getElementById('inviteLink').textContent;
  navigator.clipboard.writeText(link).then(()=>alert('COPIED')).catch(()=>{
    const range = document.createRange();
    range.selectNode(document.getElementById('inviteLink'));
    window.getSelection().removeAllRanges();
    window.getSelection().addRange(range);
    document.execCommand('copy');
    alert('COPIED');
  });
}

function switchTab(name, ev){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.content').forEach(c=>c.classList.remove('active'));
  document.getElementById('content-'+name).classList.add('active');
  ev.target.classList.add('active');
  if (name === 'invite') generateInviteLink();
  if (name === 'profile') {
    const me = window.currentUsers.find(u=>u.username===myName);
    if (me) fillProfileFields(me);
  }
}

socket.on('initial-data', d=>{
  d.chat.forEach(addMsg);
  if(d.announcements[0]){
    const el = document.getElementById('announcement');
    el.style.display='block'; el.textContent=d.announcements[0].text;
  }
  if(d.isAdmin){
    isAdmin = true;
    document.body.classList.add('admin-on');
  }
  applyRoleUI();
  socket.emit('get-initial');
});

socket.emit('get-initial');
</script>
</body>
</html>