<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CLANXU OFFICIAL</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Arial, sans-serif; }
body { background: #0a0a0a; color: #eee; min-height: 100vh; }
header { background: linear-gradient(90deg, #000, #1a0000); padding: 15px; text-align: center; border-bottom: 3px solid #ff2a2a; position: relative; }
h1 { color: #fff; text-shadow: 0 0 15px #ff2a2a; letter-spacing: 3px; font-size: 22px; }
h1 span { color: #ffd700; }
.tabs { display: flex; background: #111; border-bottom: 2px solid #333; overflow-x: auto; }
.tab { flex: 1; padding: 12px; text-align: center; cursor: pointer; color: #888; font-weight: bold; min-width: 80px; font-size: 13px; }
.tab.active { color: #ffd700; background: #1a0000; border-bottom: 3px solid #ff2a2a; }
.content { display: none; padding: 15px; }
.content.active { display: block; }
#chat { height: 400px; overflow-y: auto; background: #111; border-radius: 8px; padding: 10px; margin-bottom: 10px; border: 1px solid #333; }
.msg { background: #1a1a1a; border-left: 3px solid #ff2a2a; padding: 8px 12px; margin-bottom: 8px; border-radius: 5px; display: flex; justify-content: space-between; align-items: center; }
.msg strong { color: #ffd700; }
.del-btn { background: #ff2a2a; color: white; border: none; padding: 3px 8px; border-radius: 3px; cursor: pointer; font-size: 11px; display: none; }
.admin-on .del-btn { display: inline-block; }
.controls { display: flex; gap: 6px; }
input[type=text], select, textarea { flex: 1; padding: 12px; background: #222; border: 1px solid #444; color: white; border-radius: 6px; font-size: 14px; }
button { background: #ff2a2a; color: white; border: none; padding: 12px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; text-transform: uppercase; font-size: 12px; }
button:hover { background: #ffd700; color: black; }
.record-btn { background: #00adb5 !important; }
#announcement { background: #ffd700; color: #000; padding: 12px; border-radius: 6px; margin-bottom: 12px; display: none; font-weight: bold; }
.card { background: #111; border: 1px solid #333; border-radius: 8px; padding: 15px; margin-bottom: 12px; }
.card h3 { color: #ffd700; margin-bottom: 10px; }
.lb-row { display: flex; justify-content: space-between; padding: 10px; background: #1a1a1a; margin-bottom: 6px; border-radius: 6px; border-left: 3px solid #ffd700; }
.tier { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: bold; }
.tier.ClanXUElite { background: linear-gradient(45deg, #ff2a2a, #ffd700); color: #fff; }
.tier.Legendary { background: #ff2a2a; color: white; }
.tier.Grandmaster { background: #ff4500; color: white; }
.tier.Master { background: #a020f0; color: white; }
.tier.Pro { background: #1e90ff; color: white; }
.tier.Elite { background: #00ced1; color: black; }
.tier.Veteran { background: #32cd32; color: black; }
.tier.Rookie { background: #555; color: white; }
.tryout-item { background: #1a0a0a; padding: 10px; border-radius: 6px; margin-bottom: 8px; border-left: 3px solid #ff2a2a; }
audio { width: 100%; margin-top: 5px; }
</style>
</head>
<body>

<header>
  <h1>CLAN <span>XU</span> OFFICIAL</h1>
  <button onclick="logout()" style="position:absolute;top:10px;right:10px;padding:6px 12px;font-size:10px;background:#333;border:1px solid #ff2a2a">LOGOUT</button>
</header>

<div class="tabs">
  <div class="tab active" onclick="switchTab('chat',event)">💬 Chat</div>
  <div class="tab" onclick="switchTab('ranking',event)">🏆 Ranking</div>
  <div class="tab" onclick="switchTab('profile',event)">👤 Profile</div>
  <div class="tab" onclick="switchTab('tryout',event)">⚔️ Try-out</div>
  <div class="tab" onclick="switchTab('mailbox',event)" id="mailboxTab" style="display:none">📬 Mailbox</div>
  <div class="tab" onclick="switchTab('admin',event)" id="adminTab" style="display:none">🛡️ Admin</div>
</div>

<div id="content-chat" class="content active">
  <div id="announcement"></div>
  <div id="chat"></div>
  <div class="controls">
    <input type="text" id="msgInput" placeholder="I-type ang mensahe..." onkeypress="if(event.key==='Enter')sendMsg()">
    <button onclick="sendMsg()">Send</button>
    <button class="record-btn" id="recBtn">🎤</button>
  </div>
</div>

<div id="content-ranking" class="content">
  <div class="card">
    <h3>🏆 CLAN LEADERBOARD</h3>
    <div id="leaderboard"></div>
  </div>
</div>

<div id="content-profile" class="content">
  <div class="card">
    <h3>👤 IYONG PROFILE</h3>
    <div style="text-align:center; margin-bottom:15px">
      <img id="myAvatar" class="avatar" src="https://via.placeholder.com/80" alt="">
      <p id="myIGN" style="color:#ffd700; font-weight:bold; font-size:18px; margin-top:8px"></p>
      <p id="myRank" style="color:#00adb5; font-size:14px"></p>
    </div>
    <label>UID (CODM):</label>
    <input type="text" id="pUid" placeholder="Ilagay ang UID">
    <label>Rank:</label>
    <select id="pRank">
      <option>Rookie</option><option>Veteran</option><option>Elite</option>
      <option>Pro</option><option>Master</option><option>Grandmaster</option>
      <option>Legendary</option><option>ClanXU Elite</option>
    </select>
    <label>Collection Screenshot (link):</label>
    <input type="text" id="pShot" placeholder="Paste Imgur/Discord link">
    <button style="width:100%;margin-top:10px" onclick="saveProfile()">💾 I-SAVE</button>
  </div>
</div>

<div id="content-admin" class="content">
  <div class="card">
    <h3>🛡️ ADMIN PANEL</h3>
    <label>Announcement:</label>
    <input type="text" id="annInput" placeholder="I-type announcement...">
    <button onclick="postAnnounce()" style="width:100%">📢 POST</button>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const socket = io();
let isAdmin = false;
let myName = 'Guest';
let mediaRec, chunks = [];

// === SAVE LOGIN ===
const savedKey = localStorage.getItem('clanx_key');
const savedName = localStorage.getItem('clanx_name');
const savedAdmin = localStorage.getItem('clanx_admin') === 'true';

function logout() {
  if (confirm('Logout ka ba?')) { localStorage.clear(); location.reload(); }
}

if (savedKey && savedName) {
  myName = savedName;
  socket.emit('check-key', savedKey);
  socket.on('key-result', ok => {
    if (!ok) { localStorage.clear(); location.reload(); return; }
    if (savedAdmin) socket.emit('admin-login', { password: 'CLANXU2026', username: savedName });
    else socket.emit('request-join', { username: savedName, uid: localStorage.getItem('clanx_uid')||'N/A', rank: localStorage.getItem('clanx_rank')||'Rookie', screenshot: localStorage.getItem('clanx_shot')||'' });
  });
} else {
  const key = prompt('[ClanXU] Enter Clan Key:');
  socket.emit('check-key', key);
  socket.on('key-result', ok => {
    if (!ok) { alert('Invalid Key'); location.reload(); return; }
    const isAdminAttempt = confirm('Are you the ADMIN?');
    if (isAdminAttempt) {
      const pwd = prompt('Admin Password:');
      const name = prompt('Your IGN:');
      myName = name || 'Admin';
      localStorage.setItem('clanx_key', key);
      localStorage.setItem('clanx_name', myName);
      localStorage.setItem('clanx_admin', 'true');
      socket.emit('admin-login', { password: pwd, username: myName });
      if(document.getElementById('myIGN')) document.getElementById('myIGN').textContent = myName;
    } else {
      const name = prompt('Your IGN:');
      myName = name || 'Recruit';
      localStorage.setItem('clanx_key', key);
      localStorage.setItem('clanx_name', myName);
      localStorage.setItem('clanx_admin', 'false');
      socket.emit('request-join', { username: myName, uid: 'N/A', rank: 'Rookie', screenshot: '' });
      if(document.getElementById('myIGN')) document.getElementById('myIGN').textContent = myName;
    }
  });
}

socket.on('admin-login-fail', m => { alert(m); location.reload(); });
socket.on('admin-approved', () => {
  isAdmin = true;
  document.body.classList.add('admin-on');
  document.getElementById('adminTab').style.display = 'block';
  document.getElementById('mailboxTab').style.display = 'block';
  socket.emit('get-mailbox');
  socket.emit('get-mailbox');
});
socket.on('wait-admin-approval', () => alert('Waiting for admin approval...'));
socket.on('admin-denied', () => { alert('Admin denied.'); location.reload(); });
socket.on('wait-approval', () => alert('Waiting for approval...'));
socket.on('approved', () => alert('Welcome sa clan!'));
socket.on('denied', () => { alert('Denied.'); location.reload(); });

socket.on('new-user-request', d => {
  if (!isAdmin) return;
  if (confirm('Accept ' + d.username + '?')) socket.emit('approve-user', d.id);
  else socket.emit('deny-user', d.id);
});
socket.on('new-admin-request', d => {
  if (!isAdmin) return;
  if (confirm('Make ' + d.username + ' admin?')) socket.emit('approve-admin', d.id);
  else socket.emit('deny-admin', d.id);
});

function sendMsg() {
  const v = document.getElementById('msgInput').value.trim();
  if (!v) return;
  socket.emit('chat-message', { user: myName, text: v });
  document.getElementById('msgInput').value = '';
}
socket.on('chat-message', m => addMsg(m));
socket.on('message-deleted', id => { const e = document.getElementById('m-' + id); if (e) e.remove(); });

function addMsg(m) {
  const c = document.getElementById('chat');
  const d = document.createElement('div');
  d.className = 'msg';
  d.id = 'm-' + m.id;
  const content = m.type === 'voice' ? '<audio controls src="' + m.text + '"></audio>' : escapeHtml(m.text);
  d.innerHTML = '<div><strong>' + escapeHtml(m.user) + '</strong>: ' + content + '<br><small style="color:#555">' + m.time + '</small></div>' +
    '<button class="del-btn" onclick="delMsg(\'' + m.id + '\')">X</button>';
  c.appendChild(d);
  c.scrollTop = c.scrollHeight;
}
function delMsg(id) { socket.emit('delete-message', id); }
function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

const recBtn = document.getElementById('recBtn');
recBtn.onmousedown = recBtn.ontouchstart = startRec;
recBtn.onmouseup = recBtn.ontouchend = stopRec;
async function startRec(e) {
  e.preventDefault();
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    mediaRec = new MediaRecorder(stream);
    chunks = [];
    mediaRec.ondataavailable = ev => chunks.push(ev.data);
    mediaRec.onstop = () => {
      const blob = new Blob(chunks, { type: 'audio/webm' });
      const r = new FileReader();
      r.onloadend = () => socket.emit('chat-message', { user: myName, text: r.result, type: 'voice' });
      r.readAsDataURL(blob);
      stream.getTracks().forEach(t => t.stop());
    };
    mediaRec.start();
    recBtn.classList.add('recording');
    recBtn.textContent = '⏺';
  } catch (err) { alert('Mic denied.'); }
}
function stopRec() {
  if (mediaRec && mediaRec.state !== 'inactive') { mediaRec.stop(); recBtn.classList.remove('recording'); recBtn.textContent = '🎤'; }
}

socket.on('announcement', a => {
  const el = document.getElementById('announcement');
  el.style.display = 'block';
  el.textContent = '📢 ' + a.text;
});
function postAnnounce() {
  const v = document.getElementById('annInput').value.trim();
  if (v) { socket.emit('announce', v); document.getElementById('annInput').value = ''; }
}

function saveProfile() {
  socket.emit('save-profile', {
    username: myName,
    uid: document.getElementById('pUid').value,
    rank: document.getElementById('pRank').value,
    screenshot: document.getElementById('pShot').value
  });
}
socket.on('profile-saved', () => alert('Profile saved!'));

socket.on('users-update', users => {
  window.currentUsers = users;
  const order = ['ClanXU Elite','Legendary','Grandmaster','Master','Pro','Elite','Veteran','Rookie'];
  const sorted = [...users].sort((a,b) => order.indexOf(a.rank) - order.indexOf(b.rank));
  const lb = document.getElementById('leaderboard');
  if (sorted.length === 0) { lb.innerHTML = '<p style="color:#666">Walang members.</p>'; return; }
  lb.innerHTML = sorted.map((u,i) => {
    const cls = u.rank.replace(/\s+/g,'');
    return `<div class="lb-row" onclick="showMemberInfo('${escapeHtml(u.username)}')" style="cursor:pointer">
      <span>#${i+1} <strong>${escapeHtml(u.username)}</strong></span>
      <span class="tier ${cls}">${u.rank}</span>
    </div>`;
  }).join('');
});

function showMemberInfo(username) {
  const u = (window.currentUsers || []).find(x => x.username === username);
  if (!u) return;
  const old = document.getElementById('memberModal');
  if (old) old.remove();
  const modal = document.createElement('div');
  modal.id = 'memberModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.9);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (e) => { if (e.target === modal) modal.remove(); };
  modal.innerHTML = `<div style="background:#111;border:2px solid #ff2a2a;border-radius:10px;padding:20px;max-width:400px;width:100%;max-height:85vh;overflow-y:auto">
    <div style="text-align:center;margin-bottom:15px">
      <h2 style="color:#ffd700;margin:0">${escapeHtml(u.username)}</h2>
      <p style="color:#00adb5;font-size:14px;margin-top:5px">${u.rank}</p>
    </div>
    <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
      <p style="color:#888;font-size:11px">UID</p>
      <p style="color:#fff;font-size:14px;font-weight:bold">${escapeHtml(u.uid||'N/A')}</p>
    </div>
    <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
      <p style="color:#888;font-size:11px">RANK</p>
      <p style="color:#fff;font-size:14px;font-weight:bold">${escapeHtml(u.rank||'N/A')}</p>
    </div>
    <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
      <p style="color:#888;font-size:11px;margin-bottom:8px">SCREENSHOT</p>
      ${u.screenshot ? `<img src="${u.screenshot}" style="width:100%;border-radius:6px;border:2px solid #ff2a2a" onerror="this.outerHTML='<p style=color:#666;font-size:12px>Walang screenshot.</p>'">` : '<p style="color:#666;font-size:12px">Walang screenshot.</p>'}
    </div>
    <button onclick="document.getElementById('memberModal').remove()" style="width:100%;margin-top:10px">CLOSE</button>
  </div>`;
  document.body.appendChild(modal);
}

function showMemberInfo(username) {
  const u = (window.currentUsers || []).find(x => x.username === username);
  if (!u) return;
  const old = document.getElementById('memberModal');
  if (old) old.remove();
  const modal = document.createElement('div');
  modal.id = 'memberModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.9);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (e) => { if (e.target === modal) modal.remove(); };
  modal.innerHTML = `<div style="background:#111;border:2px solid #ff2a2a;border-radius:10px;padding:20px;max-width:400px;width:100%;max-height:85vh;overflow-y:auto">
    <div style="text-align:center;margin-bottom:15px">
      <h2 style="color:#ffd700;margin:0">${escapeHtml(u.username)}</h2>
      <p style="color:#00adb5;font-size:14px;margin-top:5px">${u.rank}</p>
    </div>
    <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
      <p style="color:#888;font-size:11px">UID</p>
      <p style="color:#fff;font-size:14px;font-weight:bold">${escapeHtml(u.uid||'N/A')}</p>
    </div>
    <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
      <p style="color:#888;font-size:11px">RANK</p>
      <p style="color:#fff;font-size:14px;font-weight:bold">${escapeHtml(u.rank||'N/A')}</p>
    </div>
    <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
      <p style="color:#888;font-size:11px;margin-bottom:8px">SCREENSHOT</p>
      ${u.screenshot ? `<img src="${u.screenshot}" style="width:100%;border-radius:6px;border:2px solid #ff2a2a" onerror="this.outerHTML='<p style=color:#666;font-size:12px>Walang screenshot.</p>'">` : '<p style="color:#666;font-size:12px">Walang screenshot.</p>'}
    </div>
    <button onclick="document.getElementById('memberModal').remove()" style="width:100%;margin-top:10px">CLOSE</button>
  </div>`;
  document.body.appendChild(modal);
}

function showMemberInfo(username) {
  const u = window.currentUsers.find(x => x.username === username);
  if (!u) return;
  
  // Burahin yung dating modal kung meron
  const old = document.getElementById('memberModal');
  if (old) old.remove();
  
  const modal = document.createElement('div');
  modal.id = 'memberModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.9);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (e) => { if (e.target === modal) modal.remove(); };
  
  modal.innerHTML = `
    <div style="background:#111;border:2px solid #ff2a2a;border-radius:10px;padding:20px;max-width:400px;width:100%;max-height:85vh;overflow-y:auto">
      <div style="text-align:center;margin-bottom:15px">
        <h2 style="color:#ffd700;margin:0">${escapeHtml(u.username)}</h2>
        <p style="color:#00adb5;font-size:14px;margin-top:5px">${u.rank}</p>
      </div>
      
      <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
        <p style="color:#888;font-size:11px;letter-spacing:1px">UID</p>
        <p style="color:#fff;font-size:14px;font-weight:bold">${escapeHtml(u.uid || 'N/A')}</p>
      </div>
      
      <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
        <p style="color:#888;font-size:11px;letter-spacing:1px">RANK</p>
        <p style="color:#fff;font-size:14px;font-weight:bold">${escapeHtml(u.rank || 'N/A')}</p>
      </div>
      
      <div style="background:#1a1a1a;border-radius:6px;padding:12px;margin-bottom:10px">
        <p style="color:#888;font-size:11px;letter-spacing:1px;margin-bottom:8px">SCREENSHOT</p>
        ${u.screenshot ? `<img src="${u.screenshot}" style="width:100%;border-radius:6px;border:2px solid #ff2a2a" onerror="this.outerHTML='<p style=\\'color:#666;font-size:12px\\'>Walang screenshot.</p>'">` : '<p style="color:#666;font-size:12px">Walang screenshot.</p>'}
      </div>
      
      <button onclick="document.getElementById('memberModal').remove()" style="width:100%;margin-top:10px;background:#ff2a2a">CLOSE</button>
    </div>
  `;
  
  document.body.appendChild(modal);
}

function submitTryout() {
  socket.emit('submit-tryout', {
    username: document.getElementById('tUser').value,
    uid: document.getElementById('tUid').value,
    rank: document.getElementById('tRank').value,
    message: document.getElementById('tMsg').value
  });
}
socket.on('tryout-submitted', () => alert('Tryout submitted!'));

// === MAILBOX ===
socket.on('mailbox-data', data => { if (isAdmin) renderMailbox(data); });
socket.on('mailbox-refresh', data => { if (isAdmin) renderMailbox(data); });

function renderMailbox(data) {
  if (!data) return;
  document.getElementById('jCount').textContent = data.joins.length;
  document.getElementById('aCount').textContent = data.admins.length;
  document.getElementById('tCount').textContent = data.tryouts.length;

  const j = document.getElementById('mailJoinList');
  j.innerHTML = data.joins.length === 0 ? '<p style="color:#666">Walang request.</p>' :
    data.joins.map(r => `<div style="background:#1a1a1a;padding:10px;border-radius:6px;margin-bottom:8px;border-left:3px solid #ff2a2a">
      <strong style="color:#ffd700">${r.username}</strong>
      <p style="color:#666;font-size:11px;margin:4px 0">${r.time}</p>
      <button onclick="socket.emit('approve-user','${r.id}')" style="padding:6px 10px;font-size:10px">✅ ACCEPT</button>
      <button onclick="socket.emit('deny-user','${r.id}')" style="padding:6px 10px;font-size:10px;background:#444">❌ DENY</button>
    </div>`).join('');

  const a = document.getElementById('mailAdminList');
  a.innerHTML = data.admins.length === 0 ? '<p style="color:#666">Walang request.</p>' :
    data.admins.map(r => `<div style="background:#1a1a1a;padding:10px;border-radius:6px;margin-bottom:8px;border-left:3px solid #ffd700">
      <strong style="color:#ffd700">${r.username}</strong>
      <p style="color:#666;font-size:11px;margin:4px 0">${r.time}</p>
      <button onclick="socket.emit('approve-admin','${r.id}')" style="padding:6px 10px;font-size:10px">✅ ACCEPT</button>
      <button onclick="socket.emit('deny-admin','${r.id}')" style="padding:6px 10px;font-size:10px;background:#444">❌ DENY</button>
    </div>`).join('');

  const t = document.getElementById('mailTryoutList');
  t.innerHTML = data.tryouts.length === 0 ? '<p style="color:#666">Walang try-out.</p>' :
    data.tryouts.map(r => `<div style="background:#1a0a0a;padding:10px;border-radius:6px;margin-bottom:8px;border-left:3px solid #ff2a2a">
      <strong style="color:#ffd700">${escapeHtml(r.username)}</strong>
      <p style="color:#888;font-size:12px;margin:4px 0">UID: ${escapeHtml(r.uid)} · Rank: ${escapeHtml(r.rank)}</p>
      <p style="color:#ccc;font-size:12px">${escapeHtml(r.message || '')}</p>
      <button onclick="socket.emit('approve-tryout',${r.id})" style="padding:6px 10px;font-size:10px">✅ ACCEPT</button>
      <button onclick="socket.emit('deny-tryout',${r.id})" style="padding:6px 10px;font-size:10px;background:#444">❌ DENY</button>
    </div>`).join('');
}


function fillProfileFields() {
  const ign = document.getElementById('myIGN');
  const rank = document.getElementById('myRank');
  if (ign) ign.textContent = myName;
  if (rank && window.currentUsers) {
    const me = window.currentUsers.find(u => u.username === myName);
    if (me) {
      if (rank) rank.textContent = me.rank || '';
      if (document.getElementById('pUid')) document.getElementById('pUid').value = me.uid || '';
      if (document.getElementById('pRank')) document.getElementById('pRank').value = me.rank || 'Rookie';
      if (document.getElementById('pShot')) document.getElementById('pShot').value = me.screenshot || '';
    }
  }
}

function switchTab(name, ev) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.content').forEach(c => c.classList.remove('active'));
  document.getElementById('content-' + name).classList.add('active');
  ev.target.classList.add('active');
}

socket.on('initial-data', d => {
  d.chat.forEach(addMsg);
  if (d.announcements[0]) {
    const el = document.getElementById('announcement');
    el.style.display = 'block';
    el.textContent = '📢 ' + d.announcements[0].text;
  }
  if (d.isAdmin) {
    isAdmin = true;
    document.body.classList.add('admin-on');
    document.getElementById('adminTab').style.display = 'block';
    document.getElementById('mailboxTab').style.display = 'block';
  socket.emit('get-mailbox');
    if (d.mailbox) renderMailbox(d.mailbox);
  }
});

socket.emit('get-initial');
</script>
</body>
</html>