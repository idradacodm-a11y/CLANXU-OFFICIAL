*{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#050507;--bg2:#0a0a10;--card:#0d0d14;--line:#1a1a28;
  --red:#ff1e2d;--red2:#c4121e;--gold:#ffb800;--cyan:#00e5ff;
  --green:#00ff88;--txt:#e8e8ef;--dim:#606074;
}

html,body{
  width:100%;max-width:100%;overflow-x:hidden;
  margin:0;padding:0;
}
body{
  font-family:'Rajdhani','Segoe UI',sans-serif;
  background:var(--bg);color:var(--txt);min-height:100vh;
  background-image:
    linear-gradient(rgba(255,30,45,.03) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,30,45,.03) 1px,transparent 1px);
  background-size:40px 40px;
}
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:999;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,.15) 0px,rgba(0,0,0,.15) 1px,transparent 1px,transparent 3px);
  opacity:.3;
}

/* ═══ HEADER — COMPACT FULL WIDTH ═══ */
header{
  position:relative;padding:10px 8px 8px;text-align:center;
  background:linear-gradient(180deg,#0d0d14,#050507);
  border-bottom:2px solid var(--red);overflow:hidden;
  width:100%;max-width:100%;
}
header::after{
  content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,var(--red),var(--gold),var(--red),transparent);
  animation:slide 4s linear infinite;
}
@keyframes slide{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}

.clan-logo{
  width:56px;height:56px;object-fit:contain;
  margin:0 auto 4px;display:block;
  filter:drop-shadow(0 0 12px rgba(255,30,45,.8));
  animation:logoPulse 3s ease-in-out infinite;
}
@keyframes logoPulse{
  0%,100%{filter:drop-shadow(0 0 10px rgba(255,30,45,.6))}
  50%{filter:drop-shadow(0 0 22px rgba(255,30,45,1))}
}

.brand{
  font-family:'Orbitron',sans-serif;font-weight:900;
  font-size:22px;letter-spacing:5px;line-height:1;
  background:linear-gradient(180deg,#fff 0%,var(--red) 60%,var(--red2) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  filter:drop-shadow(0 0 8px rgba(255,30,45,.6));
}
.brand span{color:var(--gold);-webkit-text-fill-color:var(--gold);filter:drop-shadow(0 0 6px var(--gold))}

.tag{
  font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--dim);
  letter-spacing:2px;margin-top:3px;
}
.tag b{color:var(--red);font-weight:700}

.threat-quote{
  margin:6px auto 0;padding:6px 10px;max-width:100%;
  font-family:'Orbitron',sans-serif;font-weight:700;
  font-size:8px;letter-spacing:1px;line-height:1.5;
  color:#8a8a9a;
  border-top:1px solid rgba(255,30,45,.2);
  border-bottom:1px solid rgba(255,30,45,.2);
}
.threat-quote span{color:var(--red);text-shadow:0 0 8px var(--red);font-weight:900}

#logoutBtn{
  position:absolute;top:6px;right:6px;padding:4px 8px;
  font-family:'Orbitron',sans-serif;font-size:7px;font-weight:700;letter-spacing:1px;
  background:transparent;color:var(--dim);border:1px solid var(--line);
  border-radius:2px;cursor:pointer;transition:.2s;
}
#logoutBtn:hover{border-color:var(--red);color:var(--red)}

/* ═══ TABS — ALL FIT IN ONE ROW ═══ */
.tabs{
  display:flex;background:var(--bg2);border-bottom:1px solid var(--line);
  width:100%;max-width:100%;position:sticky;top:0;z-index:100;
  overflow-x:auto;scrollbar-width:none;
}
.tabs::-webkit-scrollbar{display:none}
.tab{
  flex:1 1 0;padding:9px 2px;text-align:center;cursor:pointer;
  color:var(--dim);font-family:'Orbitron',sans-serif;
  font-size:8px;font-weight:700;letter-spacing:0;
  min-width:0;border-right:1px solid var(--line);
  transition:.2s;position:relative;text-transform:uppercase;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;
}
.tab:last-child{border-right:none}
.tab.active{color:#fff;background:linear-gradient(180deg,rgba(255,30,45,.15),transparent)}
.tab.active::after{
  content:'';position:absolute;bottom:0;left:5%;right:5%;height:2px;
  background:var(--red);box-shadow:0 0 10px var(--red);
}

/* ═══ CONTENT — FULL WIDTH EDGE-TO-EDGE ═══ */
.content{
  display:none;padding:10px 8px;width:100%;max-width:100%;
  animation:fade .2s ease;
}
.content.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

.card{
  background:var(--card);border:1px solid var(--line);border-radius:3px;
  padding:12px 10px;margin-bottom:8px;position:relative;width:100%;max-width:100%;
}
.card::before{content:'';position:absolute;top:0;left:0;width:26px;height:2px;background:var(--red)}
.card::after{content:'';position:absolute;top:0;left:0;width:2px;height:26px;background:var(--red)}
.card h3{
  font-family:'Orbitron',sans-serif;font-weight:800;
  font-size:11px;color:#fff;letter-spacing:2px;
  margin-bottom:10px;text-transform:uppercase;
  display:flex;align-items:center;gap:6px;
}
.card h3::before{content:'▎';color:var(--red);font-size:14px}
.card h4{
  font-family:'Orbitron',sans-serif;font-size:9px;color:var(--gold);
  letter-spacing:2px;margin:10px 0 5px;text-transform:uppercase;
}

/* ═══ CHAT — FULL HEIGHT ═══ */
#chat{
  height:calc(100vh - 340px);min-height:300px;overflow-y:auto;
  background:var(--bg2);border:1px solid var(--line);border-radius:3px;
  padding:8px;margin-bottom:6px;font-size:12px;width:100%;max-width:100%;
}
#chat::-webkit-scrollbar{width:4px}
#chat::-webkit-scrollbar-thumb{background:var(--red)}
.msg{
  background:var(--card);border-left:2px solid var(--red);
  padding:6px 8px;margin-bottom:5px;border-radius:2px;
  display:flex;justify-content:space-between;align-items:flex-start;gap:6px;
  word-break:break-word;
}
.msg:hover{background:#111120;border-left-color:var(--gold)}
.msg strong{
  color:var(--gold);font-weight:700;margin-right:4px;
  font-family:'Orbitron',sans-serif;font-size:9px;letter-spacing:.5px;
}
.del-btn{
  background:transparent;border:1px solid var(--red);color:var(--red);
  padding:2px 6px;border-radius:2px;cursor:pointer;font-size:9px;
  font-family:'JetBrains Mono';display:none;flex-shrink:0;
}
.admin-on .del-btn{display:inline-block}
.del-btn:hover{background:var(--red);color:#fff}

.controls{display:flex;gap:4px;width:100%}
.controls input[type=text]{min-width:0;flex:1;font-size:12px;padding:9px 10px}
.controls button{flex-shrink:0;padding:9px 10px;font-size:10px}

/* ═══ INPUTS ═══ */
input[type=text],input[type=password],select,textarea{
  flex:1;padding:9px 10px;background:var(--bg2);border:1px solid var(--line);
  color:#fff;border-radius:2px;font-family:'Rajdhani',sans-serif;font-size:13px;
  font-weight:500;transition:.2s;width:100%;max-width:100%;
}
input:focus,select:focus,textarea:focus{
  outline:none;border-color:var(--red);box-shadow:0 0 0 2px rgba(255,30,45,.12);
}
input::placeholder,textarea::placeholder{color:var(--dim);font-size:11px}

/* ═══ BUTTONS ═══ */
button{
  background:linear-gradient(135deg,var(--red),var(--red2));
  color:#fff;border:none;padding:9px 12px;border-radius:2px;
  font-family:'Orbitron',sans-serif;font-weight:700;font-size:10px;
  letter-spacing:1px;cursor:pointer;text-transform:uppercase;transition:.2s;
}
button:hover{box-shadow:0 0 15px rgba(255,30,45,.5)}
.btn-gold{background:linear-gradient(135deg,var(--gold),#cc9200);color:#000}
.btn-cyan{background:linear-gradient(135deg,var(--cyan),#0088aa);color:#000}
.btn-green{background:linear-gradient(135deg,var(--green),#009955);color:#000}
.btn-ghost{background:transparent;border:1px solid var(--line);color:var(--txt)}

.record-btn{background:linear-gradient(135deg,var(--cyan),#0088aa)!important;padding:9px 11px!important;color:#000}
.record-btn.recording{background:var(--red)!important;color:#fff;animation:pulse 1s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,30,45,.7)}50%{box-shadow:0 0 0 8px rgba(255,30,45,0)}}

#announcement{
  background:linear-gradient(90deg,rgba(255,184,0,.15),rgba(255,30,45,.15));
  border:1px solid var(--gold);border-left:3px solid var(--gold);
  padding:8px 10px;border-radius:2px;margin-bottom:8px;
  display:none;font-family:'Rajdhani',sans-serif;font-weight:700;font-size:12px;
  color:var(--gold);letter-spacing:.5px;word-break:break-word;
}
#announcement::before{content:'◈ ';font-family:'Orbitron',sans-serif;font-size:10px}

label{
  display:block;font-family:'Orbitron',sans-serif;
  font-size:8px;color:var(--dim);letter-spacing:1.5px;
  margin-bottom:4px;margin-top:8px;text-transform:uppercase;
}

/* ═══ LEADERBOARD ═══ */
.lb-row{
  display:flex;justify-content:space-between;align-items:center;gap:6px;
  padding:9px 10px;background:var(--bg2);margin-bottom:5px;
  border-radius:2px;border-left:3px solid var(--line);
  cursor:pointer;transition:.2s;width:100%;max-width:100%;
}
.lb-row:hover{border-left-color:var(--red);background:#111120;transform:translateX(2px)}
.lb-rank{
  font-family:'Orbitron',sans-serif;font-weight:900;font-size:12px;
  color:var(--red);margin-right:6px;display:inline-block;min-width:26px;
}
.lb-name{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:14px;color:#fff}

.tier{
  display:inline-block;padding:2px 8px;border-radius:2px;
  font-family:'Orbitron',sans-serif;font-size:8px;font-weight:700;
  letter-spacing:.5px;text-transform:uppercase;white-space:nowrap;flex-shrink:0;
}
.tier.ClanXUElite{background:linear-gradient(135deg,var(--red),var(--gold));color:#fff}
.tier.Legendary{background:var(--red);color:#fff}
.tier.Grandmaster{background:#ff5500;color:#fff}
.tier.Master{background:#a020f0;color:#fff}
.tier.Pro{background:#1e90ff;color:#fff}
.tier.Elite{background:var(--cyan);color:#000}
.tier.Veteran{background:var(--green);color:#000}
.tier.Rookie{background:#444;color:#aaa}

.role-tag{
  display:inline-block;padding:2px 6px;border-radius:2px;
  font-family:'Orbitron',sans-serif;font-size:7px;font-weight:700;letter-spacing:.5px;
  margin-left:4px;text-transform:uppercase;
}
.role-Tryouter{background:var(--gold);color:#000}
.role-Member{background:var(--cyan);color:#000}
.role-Admin{background:var(--red);color:#fff}

.badge-role{
  display:inline-block;padding:3px 10px;border-radius:2px;
  font-family:'Orbitron',sans-serif;font-size:9px;font-weight:700;letter-spacing:1.5px;
  margin-top:5px;text-transform:uppercase;
}

.avatar{
  width:80px;height:80px;border-radius:3px;
  border:2px solid var(--red);object-fit:cover;
  box-shadow:0 0 15px rgba(255,30,45,.5);
}

audio{width:100%;margin-top:5px}

.mbox{
  background:var(--bg2);padding:10px;border-radius:2px;
  margin-bottom:6px;border-left:3px solid var(--red);
  width:100%;max-width:100%;word-break:break-word;
}
.mbox strong{font-family:'Orbitron',sans-serif;font-size:10px;letter-spacing:1px;color:var(--gold)}

.invite-box{
  background:linear-gradient(135deg,#0a1a0a,#0d140d);
  border:1px solid var(--green);border-left:3px solid var(--green);
  padding:10px;border-radius:2px;width:100%;
}
.invite-link{
  background:#000;padding:8px;border-radius:2px;
  font-family:'JetBrains Mono',monospace;font-size:10px;word-break:break-all;
  color:var(--green);margin-top:5px;border:1px solid var(--line);
}

.hero{
  text-align:center;padding:12px 0 10px;
  border-bottom:1px dashed var(--line);margin-bottom:10px;
}
.hero-logo{
  font-family:'Orbitron',sans-serif;font-weight:900;font-size:30px;
  letter-spacing:6px;line-height:1;
  background:linear-gradient(180deg,#fff 0%,var(--red) 55%,var(--red2) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  filter:drop-shadow(0 0 18px rgba(255,30,45,.5));
}
.hero-sub{
  font-family:'JetBrains Mono',monospace;font-size:8px;
  color:var(--dim);letter-spacing:3px;margin-top:5px;
}
.hero-sub b{color:var(--gold)}

.empty{
  text-align:center;padding:25px 12px;color:var(--dim);
  font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1px;
}

/* ═══ TABLET ═══ */
@media (min-width:520px){
  .clan-logo{width:64px;height:64px}
  .brand{font-size:26px;letter-spacing:6px}
  .tag{font-size:8px;letter-spacing:2.5px}
  .threat-quote{font-size:9px;letter-spacing:1.5px;padding:7px 12px}
  .tab{font-size:9px;padding:11px 6px}
  #chat{height:calc(100vh - 360px)}
  .lb-name{font-size:15px}
  .avatar{width:90px;height:90px}
  .hero-logo{font-size:38px;letter-spacing:8px}
}

/* ═══ LARGE PHONE / TABLET ═══ */
@media (min-width:720px){
  header{padding:14px 16px 10px}
  .clan-logo{width:76px;height:76px}
  .brand{font-size:32px;letter-spacing:9px}
  .tag{font-size:9px;letter-spacing:3px}
  .threat-quote{font-size:11px;letter-spacing:2px;padding:9px 16px;max-width:700px}
  
  .tab{font-size:10px;padding:13px 10px;letter-spacing:.5px}
  .content{padding:14px 14px}
  #chat{height:calc(100vh - 380px);font-size:14px}
  
  .card{padding:16px 14px}
  .card h3{font-size:13px}
  
  .lb-row{padding:12px 14px}
  .lb-name{font-size:16px}
  .lb-rank{font-size:14px}
  
  .avatar{width:100px;height:100px}
  .hero-logo{font-size:44px;letter-spacing:10px}
  .hero-sub{font-size:10px;letter-spacing:5px}
  
  input[type=text],input[type=password],select,textarea{font-size:14px;padding:11px 12px}
  button{font-size:11px;padding:11px 16px}
}

/* ═══ DESKTOP — WIDE ═══ */
@media (min-width:1000px){
  .content{padding:18px 20px;max-width:100%}
  
  .clan-logo{width:88px;height:88px}
  .brand{font-size:38px;letter-spacing:12px}
  .threat-quote{font-size:12px;letter-spacing:2.5px;max-width:800px}
  
  .tab{font-size:12px;padding:15px 14px;letter-spacing:1px}
  
  #chat{height:calc(100vh - 420px);font-size:15px;padding:14px}
  
  .card{padding:20px 18px}
  .card h3{font-size:14px}
  .card h4{font-size:10px}
  
  .lb-row{padding:14px 18px}
  .lb-name{font-size:17px}
  .lb-rank{font-size:15px}
  .tier{font-size:9px;padding:3px 10px}
  .role-tag{font-size:8px;padding:3px 8px}
  
  .avatar{width:120px;height:120px}
  
  input[type=text],input[type=password],select,textarea{font-size:15px;padding:13px 14px}
  button{font-size:12px;padding:13px 20px}
  label{font-size:9px;margin-top:10px}
  
  .hero-logo{font-size:56px;letter-spacing:14px}
  .hero-sub{font-size:11px;letter-spacing:6px}
}

/* ═══ ULTRA WIDE ═══ */
@media (min-width:1400px){
  .content{padding:22px 28px}
  #chat{font-size:16px}
  .lb-name{font-size:18px}
  .card h3{font-size:15px}
}

/* ═══ SHORT SCREEN HEIGHT (para sa landscape) ═══ */
@media (max-height:600px){
  .clan-logo{width:40px;height:40px}
  .brand{font-size:20px}
  .threat-quote{display:none}
  #chat{height:calc(100vh - 280px)}
}